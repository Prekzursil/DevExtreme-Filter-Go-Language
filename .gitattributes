# The static/app tree is a vendored, pre-built React bundle (build output, not
# first-party source). Mark it linguist-vendored so it is excluded from language
# stats and treated as generated by code-review tooling. The lean quality gate's
# biome + oxlint additionally ignore it via biome.json / .oxlintrc.json.
static/app/** linguist-vendored
static/app/static/js/*.js linguist-generated
